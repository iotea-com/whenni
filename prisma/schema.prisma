generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "fullTextSearch"]
}

generator go {
  provider        = "go run github.com/steebchen/prisma-client-go"
  previewFeatures = ["multiSchema", "fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["app"]
}

model Space {
  id             String           @id
  organizationId String
  name           String
  createdAt      DateTime         @default(now())
  createdBy      String
  updatedAt      DateTime         @default(now())
  updatedBy      String
  channels       Channel[]
  models         Model[]
  permissionSets PermissionSet[]
  things         Thing[]
  certificates   Certificate[]
  environments   DevEnvironment[]
  organization   Organization     @relation(fields: [organizationId], references: [id])
  apiKeys        ApiKey[]
  availableTags  Tag[]
  AppliedTag     AppliedTag[]

  @@map("spaces")
  @@schema("app")
}

enum UserOnSpaceRole {
  MEMBER
  OWNER

  @@schema("app")
}

model Channel {
  id          String       @id
  name        String
  spaceId     String
  config      Json
  createdAt   DateTime     @default(now())
  createdBy   String
  updatedAt   DateTime     @default(now())
  updatedBy   String
  publishedAt DateTime?
  publishedBy String?
  space       Space        @relation(fields: [spaceId], references: [id])
  tags        AppliedTag[]

  @@map("channels")
  @@schema("app")
}

model Model {
  id         String       @id
  spaceId    String
  name       String
  attributes Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  createdBy  String
  updatedBy  String
  space      Space        @relation(fields: [spaceId], references: [id])
  tags       AppliedTag[]

  @@map("models")
  @@schema("app")
}

model PermissionSet {
  id                     String                  @id
  organizationId         String
  spaceId                String? // null means org-level permission set
  name                   String
  permissions            String[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now())
  createdBy              String
  updatedBy              String
  organization           Organization            @relation(fields: [organizationId], references: [id])
  space                  Space?                  @relation(fields: [spaceId], references: [id])
  organizationMembers    OrganizationMember[]    @relation("OrgMemberOnOrgPermissionSet")
  memberSpacePermissions MemberSpacePermission[]
  organizationApiKeys    ApiKey[]                @relation("OrgApiKeys")
  spaceApiKeys           ApiKey[]                @relation("SpaceApiKeys")

  @@map("permissions")
  @@schema("app")
}

model ApiKey {
  id                          String         @id
  organizationId              String
  organizationPermissionSetId String?
  spaceId                     String?
  spacePermissionSetId        String?
  name                        String?
  createdAt                   DateTime       @default(now())
  createdBy                   String
  expiresAt                   DateTime?
  organization                Organization   @relation(fields: [organizationId], references: [id])
  organizationPermissionSet   PermissionSet? @relation("OrgApiKeys", fields: [organizationPermissionSetId], references: [id])
  space                       Space?         @relation(fields: [spaceId], references: [id])
  spacePermissionSet          PermissionSet? @relation("SpaceApiKeys", fields: [spacePermissionSetId], references: [id])

  @@map("apiKeys")
  @@schema("app")
}

model Thing {
  id            String       @id
  name          String
  spaceId       String
  attributes    Json
  internal      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  createdBy     String
  updatedBy     String
  thingCategory String
  space         Space        @relation(fields: [spaceId], references: [id])
  tags          AppliedTag[]

  @@map("things")
  @@schema("app")
}

model Certificate {
  id      String  @id
  name    String
  spaceId String
  policy  Json
  revoke  Boolean @default(false)

  space Space @relation(fields: [spaceId], references: [id])

  @@map("certificates")
  @@schema("app")
}

model DevEnvironment {
  id              Int      @id @default(autoincrement()) // Primary key auto-incrementing ID
  environmentId   String   @unique
  environmentName String
  region          String
  state           String
  publicDns       String
  sshKeyName      String
  createdAt       DateTime @default(now())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])

  @@map("environments")
  @@schema("app")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("app")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("app")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]

  organizations OrganizationMember[]
  authTokens     AuthToken[]

  @@map("users")
  @@schema("app")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  MAGIC_LINK
  REFRESH

  @@schema("app")
}

model AuthToken {
  userId    String
  token     String        @unique
  type      AuthTokenType
  expiresAt DateTime
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("auth_tokens")
  @@schema("app")
}

model Organization {
  id               String   @id
  name             String
  createdAt        DateTime @default(now())
  createdBy        String
  updatedAt        DateTime @default(now())
  updatedBy        String

  spaces        Space[]
  members       OrganizationMember[]
  apiKeys       ApiKey[]
  PermissionSet PermissionSet[]

  @@map("organizations")
  @@schema("app")
}

model OrganizationMember {
  id                          String           @id @default(cuid())
  organizationId              String
  userId                      String
  role                        OrganizationRole @default(MEMBER)
  organizationPermissionSetId String
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @default(now())

  organization              Organization            @relation(fields: [organizationId], references: [id])
  user                      User                    @relation(fields: [userId], references: [id])
  organizationPermissionSet PermissionSet           @relation("OrgMemberOnOrgPermissionSet", fields: [organizationPermissionSetId], references: [id])
  spacePermissions          MemberSpacePermission[]

  @@unique([organizationId, userId])
  @@map("organization_members")
  @@schema("app")
}

enum OrganizationRole {
  MEMBER
  ADMIN

  @@schema("app")
}

model MemberSpacePermission {
  id                   String   @id @default(cuid())
  organizationMemberId String
  permissionSetId      String
  createdAt            DateTime @default(now())

  member        OrganizationMember @relation(fields: [organizationMemberId], references: [id])
  permissionSet PermissionSet      @relation(fields: [permissionSetId], references: [id])

  @@unique([organizationMemberId, permissionSetId])
  @@map("member_space_permissions")
  @@schema("app")
}

model Tag {
  id           String       @id @default(cuid())
  name         String
  spaceId      String
  space        Space        @relation(fields: [spaceId], references: [id])
  applications AppliedTag[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String
  updatedBy    String

  @@map("tags")
  @@schema("app")
}

model AppliedTag {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id])
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id])
  modelId   String?
  model     Model?   @relation(fields: [modelId], references: [id])
  thingId   String?
  thing     Thing?   @relation(fields: [thingId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  @@map("applied_tags")
  @@schema("app")
}

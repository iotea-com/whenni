{
	"name": "db",
	"$schema": "../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "prisma",
	"projectType": "application",
	"targets": {
		"setup": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					{
						"command": "nx run db:generate-client"
					},
					{
						"command": "nx run db:push"
					},
					{
						"command": "nx run db:seed"
					}
				],
				"cwd": "{workspaceRoot}",
				"parallel": false
			}
		},
		"generate-client": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					{
						"command": "chmod +x ./gen-client.sh && ./gen-client.sh"
					}
				],
				"cwd": "{projectRoot}",
				"parallel": false
			}
		},
		"push": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					{
						"command": "yarn prisma db push --skip-generate"
					}
				],
				"cwd": "{projectRoot}",
				"parallel": false
			}
		},
		"seed": {
			"executor": "nx:run-commands",
			"defaultConfiguration": "docker",
			"configurations": {
				"docker": {
					"commands": [
						{
							"command": "/bin/zsh -c 'source .env && go run main.go --k8sEnabled=false'"
						},
						{
							"command": "nx run nodes:build --skip-nx-cache"
						}
					],
					"cwd": "{projectRoot}/seed",
					"parallel": false
				},
				"k8s": {
					"commands": [
						{
							"command": "nx run engine:dev -c up"
						},
						{
							"command": "/bin/zsh -c 'source .env && go run main.go --k8sEnabled=false'"
						},
						{
							"command": "nx run nodes:build-container --skip-nx-cache"
						},
						{
							"command": "nx run nodes:build --skip-nx-cache"
						}
					],
					"cwd": "{projectRoot}/seed",
					"parallel": false
				}
			}
		}
	},
	"tags": []
}
          "pluginVersion": "4.7.0",
          "queryType": "traces",
          "rawSql": "SELECT \"TraceId\" as traceID, \"ServiceName\" as serviceName, \"SpanAttributes\" as spanAttributes, \"SpanName\" as operationName, \"Timestamp\" as startTime, multiply(\"Duration\", 0.000001) as duration FROM \"platform\".\"otel_traces\" WHERE ( Timestamp >= $__fromTime AND Timestamp <= $__toTime ) AND ( ParentSpanId = '' ) AND ( Duration > 0 ) AND ( ServiceName = 'HTTP API' ) ORDER BY Timestamp DESC, Duration DESC LIMIT 1000",
          "refId": "A"
        }
      ],
      "title": "HTTP Core API Traces",

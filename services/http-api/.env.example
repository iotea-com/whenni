LOG_LEVEL="debug"

# Vault
VAULT_ADDRESS="http://127.0.0.1:8200"
API_VAULT_USERNAME="http-api"
API_VAULT_PASSWORD="iotea"

# API server port
API_SERVER_PORT=9001

# Orchestrator gRPC end point
ENGINE_GRPC_SERVER_URL="127.0.0.1:50051"

# Collector runtime metrics end point
COLLECTOR_GRPC_RUNTIME_URL="127.0.0.1:50053"

# Database
DATABASE_URL=postgresql://iotea:iotea@127.0.0.1:5432/iotea?schema=app
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Observability
OTEL_COLLECTOR_ENDPOINT="127.0.0.1:4317"

# Dev Environments
DEVENV_GRPC_SERVER_URL="127.0.0.1:50052"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=iotea
REDIS_PASSWORD=iotea
